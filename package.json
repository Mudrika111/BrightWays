{
  "name": "brightways",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.tsx --host 0.0.0.0",
    "build": "tsc -p backend/tsconfig.json && vite build --config vite.config.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p backend/tsconfig.json",
    "start": "npm run build && npm --prefix backend run start:server"
  },
  "dependencies": {
    "mysql2": "^3.22.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
